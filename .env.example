# Скопировать в .env рядом с scout.py и заполнить. Сам .env в git НЕ уходит.

# --- Telegram (обязательно, иначе уведомлений не будет) ---
# Токен от @BotFather. Свой chat_id узнаётся у @userinfobot.
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- X / Twitter (без этих двух твиттер-слой просто выключен) ---
# ВОЗЬМИТЕ ОТДЕЛЬНЫЙ АККАУНТ, НЕ ОСНОВНОЙ: автоматический сбор против
# правил X, аккаунты за это блокируют.
# Где взять: залогиниться в этот аккаунт в браузере -> F12 -> вкладка
# Application (Chrome) / Storage (Firefox) -> Cookies -> https://x.com ->
# скопировать значения auth_token и ct0.
# Куки живут месяцами, но протухают при смене пароля и при выходе из
# аккаунта в браузере. Признак: в логе «401/403 — куки не приняты».
X_AUTH_TOKEN=
X_CT0=
# Пауза между запросами к X в секундах. Меньше 1.2 — заметный риск.
X_DELAY=1.6

# --- GitHub (необязательно) ---
# Без токена 10 поисков в минуту на IP, с токеном 30. Хватает и без него.
# Токен нужен только на чтение публичного: github.com/settings/tokens
GITHUB_TOKEN=
